# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=outdoor_assistant

# DeepSeek 官方配置
COMPATIBLE_API_KEY=your_api_key
COMPATIBLE_BASE_URL=https://api.deepseek.com/v1
COMPATIBLE_MODEL=deepseek-v4-flash

# 代理配置（Docker 容器内需使用 host.docker.internal 代替 127.0.0.1）
# 如果主机运行了 Clash/代理软件（TUN 模式），会导致 Docker 容器 TLS 连接失败
# 解决方案 A: 在 Clash 中关闭 TUN 模式，改为系统代理模式
# 解决方案 B: 配置 HTTP_PROXY 指向主机代理（确保代理监听 0.0.0.0 而非 127.0.0.1）
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1,host.docker.internal

# MCP 服务配置
MCP_12306_TYPE=sse
MCP_12306_URL=https://mcp.api-inference.modelscope.net/a1736485151849/sse
MCP_WEATHER_TYPE=streamable_http
MCP_WEATHER_URL=https://mcp.api-inference.modelscope.net/60bdf046360440/mcp

# 对象存储配置
# 后端: "local"（默认，本地文件系统）或 "minio"（S3兼容对象存储）
STORAGE_BACKEND=local
# 本地存储根目录（仅 STORAGE_BACKEND=local 时生效）
STORAGE_LOCAL_DIR=app/static/img
# MinIO 配置（仅 STORAGE_BACKEND=minio 时生效）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
# 浏览器可访问的 MinIO URL（Docker 中可能是服务器 IP）
MINIO_EXTERNAL_URL=http://localhost:9000
# 逗号分隔的 bucket 名称（启动时自动创建）
MINIO_BUCKETS=avatars,uploads

# 应用配置
APP_NAME=户外徒步助手
APP_VERSION=1.0.0
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Storage (user uploads — not tracked in git)
app/static/img/avatars/*
app/static/img/uploads/*
!app/static/img/avatars/.gitkeep
!app/static/img/uploads/.gitkeep
# 仅忽略项目根目录的 data（存储挂载），app/data 下的内容审核词库需入库
/data/

# Claude Code
.claude/
docs/

# Docker
docker_volumes/

# Docker 镜像导出（部署产物）
*.tar

# SSL 证书（部署产物；.key 是私钥，绝不能提交到仓库）
*.key
*.pem
*.crt
*.cer
